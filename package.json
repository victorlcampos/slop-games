{
  "name": "slop-games",
  "version": "1.0.0",
  "description": "Jogos que rodam inteiros no navegador, cada um em um único arquivo HTML.",
  "type": "module",
  "private": true,
  "workspaces": [
    "lib",
    "jogos/*"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node lib/test/kit.test.mjs && node test/jogos.test.mjs",
    "abrir": "node build.mjs && open dist/index.html",
    "test:jogos": "npm run test --workspaces --if-present"
  },
  "license": "MIT"
}
