{
  "name": "slop-games",
  "version": "1.0.0",
  "description": "Games that run entirely in the browser, each one a single HTML file.",
  "type": "module",
  "private": true,
  "workspaces": [
    "lib",
    "games/*"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node lib/test/kit.test.mjs && node test/games.test.mjs",
    "open": "node build.mjs && open dist/index.html",
    "test:games": "npm run test --workspaces --if-present"
  },
  "license": "MIT"
}
