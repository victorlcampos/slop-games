node_modules/

# produced by `npm run build` (and by the CI job that publishes to Pages)
dist/

.DS_Store

# screenshots the tests take when something fails — the CI keeps them as an
# artifact, they have no business in the history
test/*.png
games/*/test/*.png

# audit scratch: a probe an agent leaves behind while driving a game
games/*/test/_scratch_*.mjs

# automation scratch (a scheduled script, a commit message being drafted)
.agendado.sh
.commit-msg.tmp
*.tmp.mjs

# the Omarchy plugin package, assembled by npm run omarchy:publish
dist-omarchy/
